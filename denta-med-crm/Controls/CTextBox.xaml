<UserControl x:Class="denta_med_crm.Controls.CTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:denta_med_crm.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="28" d:DesignWidth="300">
    <Grid>
        <TextBox TextWrapping="Wrap" Text="TextBox" Background="{x:Null}" BorderBrush="#FF007ACC" Foreground="#FF007ACC" FontSize="14" TextDecorations="Underline" VerticalContentAlignment="Center" Padding="2,0,0,0"/>

    </Grid>
</UserControl>
