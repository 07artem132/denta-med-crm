<Window x:Class="denta_med_crm.AddOrEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:denta_med_crm"
        xmlns:model="clr-namespace:denta_med_crm.Model"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        local:WindowBehavior.HideCloseButton="True"
        Title="Клиент" Height="534" Width="842" Name="addOrEditUserWindow" >

    <Grid Background="#FF4D6082">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Foreground" Value="#FF007ACC" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="2,0,0,0" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="Background" Value="{x:Null}" />
            </Style>
        </Grid.Resources>
        <TabControl Margin="10,10,0,0" HorizontalAlignment="Left" Width="811" Height="441" VerticalAlignment="Top" >
            <TabItem   Header="Общее" >
                <Grid>

                    <Grid Background="#FFE7E8EC" Margin="535,0,0,0">
                        <Label Content="Заметки:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.555,1.93" FontSize="14" Width="250" Background="#FFF3F3F3"/>
                        <TextBox TextWrapping="Wrap" Text="{Binding Client.ClientDescription, ElementName=addOrEditUserWindow}" Margin="10,39,10,10" Background="White" VerticalContentAlignment="Top" />
                    </Grid>

                    <TextBox  TextWrapping="Wrap" Text="{Binding Client.FullName, ElementName=addOrEditUserWindow}" Width="372" Margin="158,10,0,0" Height="29" VerticalAlignment="Top" HorizontalAlignment="Left" />
                    <Label Content="ФИО:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="14" Width="143"/>
                    <Label Content="Пол:" HorizontalAlignment="Left" Margin="10,44,0,0" VerticalAlignment="Top" FontSize="14"/>
                    <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" 
                  ItemsSource="{Binding Source={local:EnumBindingSource {x:Type model:Sex}}}" SelectedValue="{Binding Client.Sex, ElementName=addOrEditUserWindow}" Margin="158,47,0,0" Width="118" Height="26"/>

                    <Label Content="Дата рождения:" HorizontalAlignment="Left" Margin="10,180,0,0" VerticalAlignment="Top" FontSize="14"/>
                    <DatePicker x:Name="_dateOfBirth" Height="29" Width="208" SelectedDate="{Binding Client.DateOfBirth, ElementName=addOrEditUserWindow}" Margin="158,180,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="14" VerticalContentAlignment="Center"/>
                    <Label Content="Телефон:" HorizontalAlignment="Left" Margin="10,78,0,0" VerticalAlignment="Top" FontSize="14" Width="143"/>
                    <TextBox  TextWrapping="Wrap" Text="{Binding Client.MainPhoneNumber, ElementName=addOrEditUserWindow}" Width="208" Margin="158,78,0,0" Height="29" VerticalAlignment="Top" HorizontalAlignment="Left" />
                    <TextBox TextWrapping="Wrap" Text="{Binding Client.AlternativePhoneNumber, ElementName=addOrEditUserWindow}" Width="208" Margin="158,112,0,0" HorizontalAlignment="Left" Height="29" VerticalAlignment="Top"/>
                    <Label Content="Альтернативный:" HorizontalAlignment="Left" Margin="10,112,0,0" VerticalAlignment="Top" FontSize="14" RenderTransformOrigin="2.017,1.069"/>
                    <Label Content="Скидка, %:" HorizontalAlignment="Left" Margin="10,146,0,0" VerticalAlignment="Top" FontSize="14" Width="143"/>
                    <TextBox  TextWrapping="Wrap" Text="{Binding Client.Discount, ElementName=addOrEditUserWindow}" Margin="158,146,0,0" Height="29" VerticalAlignment="Top" HorizontalAlignment="Left" Width="208"/>
                    <Label Content="Последний визит:" HorizontalAlignment="Left" Margin="10,214,0,0" VerticalAlignment="Top" FontSize="14" Width="146"/>
                    <Label Content="Является клиентом с:" HorizontalAlignment="Left" Margin="10,248,0,0" VerticalAlignment="Top" FontSize="14" Width="146" RenderTransformOrigin="0.527,-0.345"/>
                    <Label Content="День рождения:" HorizontalAlignment="Left" Margin="10,282,0,0" VerticalAlignment="Top" FontSize="14" Width="146"/>
                    <Label Content="{Binding Client.FirstVisit, ElementName=addOrEditUserWindow}" ContentStringFormat="dd.MM.yyyy" HorizontalAlignment="Left" Margin="158,251,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.58,0.555" Height="26" Width="208"/>
                    <Label x:Name="_lastVisitInfo" HorizontalAlignment="Left" Margin="158,214,0,0" VerticalAlignment="Top" Width="208" Height="26" />
                    <Label x:Name="_daysToBirthday"  HorizontalAlignment="Left" Margin="158,285,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.58,0.555" Height="26" Width="208"/>
                </Grid>
            </TabItem>
            <TabItem Header="Зубная формула" >
                <Grid>
                    <ListView x:Name="_inspections" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10,10,280,225" ItemsSource="{Binding ElementName=addOrEditUserWindow, Path=Client.Inspections}" Background="#FFF6F6F6" >
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Дата осмотра" Width="140"   DisplayMemberBinding="{Binding InspectionDate, StringFormat='{}{0:dd.MM.yyyy}'}" />
                                <GridViewColumn Header="Врач" Width="150" DisplayMemberBinding="{Binding Doctor}" />
                                <GridViewColumn Header="Описание" Width="215" DisplayMemberBinding="{Binding Description}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid DataContext="{Binding ElementName=_inspections, Path=SelectedItem}">
                        <Grid Background="#FFE7E8EC" Margin="535,10,0,225">
                            <Label Content="Описание:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.555,1.93" FontSize="14" Width="250" Background="#FFF3F3F3"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding Path=Description}" Margin="10,39,10,10" Background="White" VerticalContentAlignment="Top" />
                        </Grid>

                        <Label Margin="361,246,172,138" Content="{Binding Path=InspectionDate}"  ContentStringFormat="Выбранная дата: dd.MM.yyyy"></Label>
                        <Label Margin="10,246,736,138" Content="Врач:" FontSize="14"/>
                        <TextBox Text="{Binding Path=Doctor}" Margin="74,246,0,0" HorizontalAlignment="Left" Width="261" Height="29" VerticalAlignment="Top" />
                        <Grid x:Name="_ts3" Margin="348,342,130,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="31"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="32"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="33"/>
                            <Label Grid.Row="0" Grid.Column="3" Content="34"/>
                            <Label Grid.Row="0" Grid.Column="4" Content="35"/>
                            <Label Grid.Row="0" Grid.Column="5" Content="36"/>
                            <Label Grid.Row="0" Grid.Column="6" Content="37"/>
                            <Label Grid.Row="0" Grid.Column="7" Content="38"/>
                            <TextBox TextWrapping="Wrap" Tag="38" Grid.Row="1" Grid.Column="7" />
                            <TextBox TextWrapping="Wrap" Tag="37" Grid.Row="1" Grid.Column="6" />
                            <TextBox TextWrapping="Wrap" Tag="36" Grid.Row="1" Grid.Column="5" />
                            <TextBox TextWrapping="Wrap" Tag="35" Grid.Row="1" Grid.Column="4" />
                            <TextBox TextWrapping="Wrap" Tag="34" Grid.Row="1" Grid.Column="3" />
                            <TextBox TextWrapping="Wrap" Tag="33" Grid.Row="1" Grid.Column="2" />
                            <TextBox TextWrapping="Wrap" Tag="32" Grid.Row="1" Grid.Column="1" />
                            <TextBox TextWrapping="Wrap" Tag="31" Grid.Row="1" Grid.Column="0" />
                        </Grid>
                        <Grid x:Name="_ts1" Margin="10,282,473,71">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="18"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="17"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="16"/>
                            <Label Grid.Row="0" Grid.Column="3" Content="15"/>
                            <Label Grid.Row="0" Grid.Column="4" Content="14"/>
                            <Label Grid.Row="0" Grid.Column="5" Content="13"/>
                            <Label Grid.Row="0" Grid.Column="6" Content="12"/>
                            <Label Grid.Row="0" Grid.Column="7" Content="11"/>
                            <TextBox Tag="11" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="7" />
                            <TextBox Tag="12" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="6" />
                            <TextBox Tag="13" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="5" />
                            <TextBox Tag="14" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="4" />
                            <TextBox Tag="15" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="3" />
                            <TextBox Tag="16" TextWrapping="Wrap"   Grid.Row="1" Grid.Column="2" />
                            <TextBox Tag="17" TextWrapping="Wrap"  Grid.Row="1" Grid.Column="1" />
                            <TextBox Tag="18"  TextWrapping="Wrap"  Grid.Row="1" Grid.Column="0" />
                        </Grid>
                        <Grid x:Name="_ts4" Margin="10,342,473,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="48"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="47"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="46"/>
                            <Label Grid.Row="0" Grid.Column="3" Content="45"/>
                            <Label Grid.Row="0" Grid.Column="4" Content="44"/>
                            <Label Grid.Row="0" Grid.Column="5" Content="43"/>
                            <Label Grid.Row="0" Grid.Column="6" Content="42"/>
                            <Label Grid.Row="0" Grid.Column="7" Content="41"/>
                            <TextBox TextWrapping="Wrap" Tag="41" Grid.Row="1" Grid.Column="7" />
                            <TextBox TextWrapping="Wrap" Tag="42" Grid.Row="1" Grid.Column="6" />
                            <TextBox TextWrapping="Wrap" Tag="43" Grid.Row="1" Grid.Column="5" />
                            <TextBox TextWrapping="Wrap" Tag="44" Grid.Row="1" Grid.Column="4" />
                            <TextBox TextWrapping="Wrap" Tag="45" Grid.Row="1" Grid.Column="3" />
                            <TextBox TextWrapping="Wrap" Tag="46" Grid.Row="1" Grid.Column="2" />
                            <TextBox TextWrapping="Wrap" Tag="47" Grid.Row="1" Grid.Column="1" />
                            <TextBox TextWrapping="Wrap" Tag="48" Grid.Row="1" Grid.Column="0" />
                        </Grid>
                        <Grid x:Name="_ts2" Margin="348,282,130,71">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="21"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="22"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="23"/>
                            <Label Grid.Row="0" Grid.Column="3" Content="24"/>
                            <Label Grid.Row="0" Grid.Column="4" Content="25"/>
                            <Label Grid.Row="0" Grid.Column="5" Content="26"/>
                            <Label Grid.Row="0" Grid.Column="6" Content="27"/>
                            <Label Grid.Row="0" Grid.Column="7" Content="28"/>
                            <TextBox Tag="28" TextWrapping="Wrap" Grid.Row="1" Grid.Column="7" />
                            <TextBox Tag="27" TextWrapping="Wrap" Grid.Row="1" Grid.Column="6" />
                            <TextBox Tag="26" TextWrapping="Wrap" Grid.Row="1" Grid.Column="5" />
                            <TextBox Tag="25" TextWrapping="Wrap" Grid.Row="1" Grid.Column="4" />
                            <TextBox Tag="24" TextWrapping="Wrap" Grid.Row="1" Grid.Column="3" />
                            <TextBox Tag="23" TextWrapping="Wrap" Grid.Row="1" Grid.Column="2" />
                            <TextBox Tag="22" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" />
                            <TextBox Tag="21" TextWrapping="Wrap" Grid.Row="1" Grid.Column="0" />
                        </Grid>
                        <Label Margin="0,202,0,177" Content="" Background="#FFE7E8EC" FontSize="14"/>
                        <Button x:Name="_formulaTt" Content="?" HorizontalAlignment="Left" Margin="210,206,0,0" VerticalAlignment="Top" Width="87" Height="28" FontSize="16" FontWeight="Bold" Foreground="#FF6C6C6C" Background="#FFEEEEEE" xml:space="preserve">
                            <Button.ToolTip>
Расшифровка:&#xa;
O - Отсутствует&#xa;
R - Корень&#xa;
P - Пульпит&#xa;
Pt - Переодонтит&#xa;
A - Пародонтоз&#xa;
К - Коронка&#xa;
C - Кариес&#xa;
П - Пломбированный&#xa;
B - Искусственный зуб&#xa;
П/С - Пломба/Кариес&#xa;
                            </Button.ToolTip>
                        </Button>
                        <Button x:Name="_addFormula" Content="Добавить осмотр" HorizontalAlignment="Left" Margin="10,206,0,0" VerticalAlignment="Top" Width="195" Height="28" FontSize="14" Click="_addFormula_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Записи">
                <Grid>
                    <ListView x:Name="_procedures" Margin="10,10,10,258" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding ElementName=addOrEditUserWindow, Path=Client.Procedures}" Background="#FFF6F6F6" >
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Дата время" Width="140" DisplayMemberBinding="{Binding ProcedureDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                                <GridViewColumn Header="Дительность" Width="140" DisplayMemberBinding="{Binding ProcedureDuration}" />
                                <GridViewColumn Header="Врач" Width="170" DisplayMemberBinding="{Binding Doctor}" />
                                <GridViewColumn Header="Описание" Width="220" DisplayMemberBinding="{Binding Description}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Button x:Name="_addLabel" Content="Добавить запись" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" Width="173" Height="24" FontSize="14" Click="_addLabel_Click"/>
                    <Grid DataContext="{Binding ElementName=_procedures, Path=SelectedItem}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="14*"/>
                        </Grid.RowDefinitions>
                        <Label Content="Дата:" Margin="10,203,751,83" FontSize="14"/>
                        <Label Content="Описание:" Margin="366,165,10,120" FontSize="14" Background="#FFE7E8EC" />
                        <Label Content="Врач:" Margin="10,237,730,49" FontSize="14"/>
                        <TextBox HorizontalAlignment="Left" Height="208" Margin="366,195,0,0" TextWrapping="Wrap" Text="{Binding Path=Description}" VerticalAlignment="Top" Width="429" Grid.RowSpan="2" VerticalContentAlignment="Top"/>
                        <TextBox HorizontalAlignment="Left" Height="29" Margin="89,237,0,0" TextWrapping="Wrap" Text="{Binding Path=Doctor}" VerticalAlignment="Top" Width="219"/>
                        <xctk:DateTimePicker Value="{Binding Path=ProcedureDate}" Margin="89,203,497,83" FontSize="14" VerticalContentAlignment="Center"/>
                        <Label Content="Длительность (минут):" Margin="10,273,611,13" FontSize="14"/>
                        <TextBox HorizontalAlignment="Left" Height="29" Margin="182,273,0,0" TextWrapping="Wrap" Text="{Binding Path=ProcedureDuration}" VerticalAlignment="Top" Width="126"/>
                        <CheckBox Content="Завершено" IsChecked="{Binding Path=Сompleted}"  HorizontalAlignment="Left" Margin="14,310,0,0" VerticalAlignment="Top" FontSize="14" Width="222" Grid.RowSpan="2"/>

                    </Grid>
                </Grid>
            </TabItem>


        </TabControl>
        <Button Content="Готово" Margin="635,457,0,0" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="186" FontSize="14" Click="Save_Click"/>
        <Label Content="Все изменения сохраняются автоматически" HorizontalAlignment="Left" Margin="10,458,0,0" VerticalAlignment="Top" Width="400" FontSize="14" Background="{x:Null}" Foreground="#FF97968F"/>
        <Button x:Name="_undoButton" Content="Отмена" Margin="444,457,0,0"  Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="186" FontSize="14" Click="Cancel_Click" />
    </Grid>
</Window>
