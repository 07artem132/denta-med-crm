<Window x:Class="denta_med_crm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:denta_med_crm"
        mc:Ignorable="d"
        Title="Denta Med crm" Height="450" Width="800">
    <Grid>
        <Menu VerticalAlignment="Top" Height="22" FontSize="14" >
            <MenuItem Header="База данных">
                <MenuItem Header="Загрузить" ></MenuItem>
                <MenuItem Header="Выгрузить" ></MenuItem>
            </MenuItem>
            <MenuItem Header="О программе" ></MenuItem>
            <Separator Width="10"></Separator>
            <MenuItem Header="Пациенты" Foreground="#FF0169B0" ></MenuItem>
            <MenuItem Header="Записи" Foreground="#FF0169B0" ></MenuItem>
        </Menu>
        <TabControl Margin="0,27,0,0"   >
            <!--<TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>-->
            <TabItem >
                <Grid>
                    <Button x:Name="btAddUser" Content="" Margin="0,10,0,0" Click="BtAddUser_Click" Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75">
                        <Button.Background>
                            <ImageBrush ImageSource="Images/AddUser.png" Stretch="Uniform"/>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Button.IsFocused" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3F96C1FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <DataGrid x:Name="dataGrid" Margin="0,52,0,0" SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding FirstName}" Width="150" />
                            <DataGridTextColumn Header="Имя" Binding="{Binding MiddleName}" Width="150" />
                            <DataGridTextColumn Header="Отчество" Binding="{Binding LastName}" Width="150" />
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth}" Width="150" />
                            <DataGridTextColumn Header="Первый визит" Binding="{Binding FirstVisit}" Width="150" />
                            <DataGridTextColumn Header="Последний визит" Binding="{Binding LastVisit}" Width="150" />
                            <DataGridTextColumn Header="Сидка" Binding="{Binding Discount}" Width="150" />
                            <DataGridTextColumn Header="Телефон" Binding="{Binding MainPhoneNumber}" Width="150" />
                            <DataGridTextColumn Header="Доп. телефон" Binding="{Binding AlternativePhoneNumber}" Width="150" />

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="Button_Click" Content="Процедуры"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Процедуры" Binding="{Binding Procedures}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="btAddEvent" Content="" Margin="80,10,0,0" Click="BtAddEvent_Click" Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75">
                        <Button.Background>
                            <ImageBrush ImageSource="Images/AddItem.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btEditUser" Content="" Margin="160,10,0,0" Click="BtEditUser_Click" HorizontalAlignment="Left" Width="75" Height="37" VerticalAlignment="Top">
                        <Button.Background>
                            <ImageBrush ImageSource="Images/EditUser.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem />


        </TabControl>

    </Grid>
</Window>
